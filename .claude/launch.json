{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "panel",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "chatbot/meta/public"],
      "port": 5050,
      "autoPort": true
    },
    {
      "name": "wa-cloud",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/server.js"],
      "cwd": "chatbot/whatsapp-cloud",
      "port": 3000
    },
    {
      "name": "cava-meta",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8099"],
      "cwd": "chatbot/meta",
      "port": 8099
    }
  ]
}
