# WhatsApp Cloud API — credenciales de Meta (developers.facebook.com → tu App → WhatsApp)
META_TOKEN=EAA...            # token permanente (System User) o temporal de 24h para probar
PHONE_NUMBER_ID=             # ID largo del número, NO el +1 555...
WABA_ID=                     # WhatsApp Business Account ID de La Cava
VERIFY_TOKEN=cava-verify-cambia-esto   # string secreto que tú eliges; el MISMO va en Meta
GRAPH_VERSION=v25.0          # versión del Graph API
PORT=3000
PANEL_PASSWORD=cambia-esto   # clave para entrar al panel (login). Vacío = panel sin clave.

# Supabase (persistencia de conversaciones). Si faltan, el store cae a JSON local (data/).
# Cuenta de La Cava → Project Settings → API. La SERVICE ROLE key es secreta: solo backend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (NO la anon). Nunca la expongas al navegador.
