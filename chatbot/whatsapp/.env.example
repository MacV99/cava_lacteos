# Puerto HTTP del gateway (expone /send, /qr, /status, /healthz)
PORT=8100

# URL del webhook del bot FastAPI. El gateway hace POST aquí con cada mensaje entrante.
# Local:  http://localhost:8000/webhook/whatsapp
# Render: URL interna del servicio Python + /webhook/whatsapp
BOT_WEBHOOK_URL=http://localhost:8000/webhook/whatsapp

# Secreto compartido con el bot Python. DEBE ser idéntico a WHATSAPP_SHARED_SECRET del bot.
# Viaja en el header X-Gateway-Secret en ambas direcciones.
GATEWAY_SECRET=cambia_esto_por_un_secreto_largo

# Nivel de log del gateway: silent | error | warn | info | debug (default info).
# (El logger interno de Baileys va siempre en silent aparte.)
LOG_LEVEL=info
