{
  "name": "cava-whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gateway Baileys que conecta WhatsApp por QR y lo enlaza con el bot FastAPI de Cava Lácteos (WhatsApp como canal más).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.21",
    "express": "^4.21.2",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.7.0"
  }
}
