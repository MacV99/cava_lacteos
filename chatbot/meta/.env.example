# Facebook / Meta + Instagram
META_VERIFY_TOKEN=un_token_secreto_que_tu_eliges
META_PAGE_ACCESS_TOKEN=EAAxxxxxx...
META_APP_SECRET=abc123...
META_IG_ACCESS_TOKEN=IGAAxxxxxx...
META_IG_APP_SECRET=abc456...
META_IG_ACCOUNT_ID=17841400123456789

# WhatsApp — gateway Baileys (servicio Node aparte, ver ../whatsapp)
# Local: http://localhost:8100   |   Render: URL interna del servicio Node
WHATSAPP_GATEWAY_URL=http://localhost:8100
# Mismo valor debe ir en el gateway (GATEWAY_SECRET). Genera uno largo y aleatorio.
WHATSAPP_SHARED_SECRET=cambia_esto_por_un_secreto_largo

# Panel admin — gestión de conexiones desde el panel estático (panel/)
# Origen del panel para CORS (ej. https://tu-panel.vercel.app). "*" = abierto (solo dev).
PANEL_ORIGIN=*
# Si se define, el panel debe mandar X-Panel-Token con este valor en /connections*.
PANEL_TOKEN=

# Groq
GROQ_API_KEY=gsk_xxxx...
GROQ_CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3

# Google Sheets
GOOGLE_SHEETS_ID=1i5AuzGAwY6pwoo6p092F1D6ilmDXpotNZM4krGUYIn0
# Opción A: ruta al archivo JSON del service account
GOOGLE_SA_JSON=credentials/service_account.json
# Opción B: contenido del JSON en base64 (útil en hosting como Render)
# GOOGLE_SA_JSON_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# URL del catálogo — el default está en config.py, solo sobreescribir si cambia
# CATALOG_URL=https://lacavalacteos.com/

# Comportamiento del bot
BUFFER_WAIT_SECONDS=5
HISTORY_MAX_ITEMS=28
SESSION_TIMEOUT_MINUTES=60
