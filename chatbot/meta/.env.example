# Facebook / Meta + Instagram
META_VERIFY_TOKEN=un_token_secreto_que_tu_eliges
META_PAGE_ACCESS_TOKEN=EAAxxxxxx...
META_APP_SECRET=abc123...
META_IG_ACCESS_TOKEN=IGAAxxxxxx...
META_IG_APP_SECRET=abc456...
META_IG_ACCOUNT_ID=17841400123456789

# WhatsApp Cloud API (canal oficial) — el mismo FastAPI recibe el webhook y envía por Graph.
META_TOKEN=EAAxxxxxx...          # token System User permanente del número
PHONE_NUMBER_ID=1234567890       # ID largo del número (NO el +57 300...)
WABA_ID=1234567890
GRAPH_VERSION=v25.0
# Verificación del webhook de WhatsApp en Meta. Si lo dejas vacío, se usa META_VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app Meta dueña de la WABA. Si es la MISMA app de Messenger, deja vacío
# (se usa META_APP_SECRET). Solo llénalo si la WABA vive en otra app.
WHATSAPP_APP_SECRET=

# Persistencia del panel (Supabase de La Cava). Sin estas dos → store en JSON local (solo dev).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role — secreta, solo backend

# Panel admin (mismo servicio: sirve la UI en / y las rutas /api/*)
PANEL_PASSWORD=                    # clave de login del panel. Vacío = panel abierto (solo dev)
PANEL_ORIGIN=*                     # CORS: origen del panel. "*" = abierto (el panel es same-origin)

# Groq
GROQ_API_KEY=gsk_xxxx...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Google Sheets
GOOGLE_SHEETS_ID=1i5AuzGAwY6pwoo6p092F1D6ilmDXpotNZM4krGUYIn0
# Opción A: ruta al archivo JSON del service account
GOOGLE_SA_JSON=credentials/service_account.json
# Opción B: contenido del JSON en base64 (útil en hosting como Render)
# GOOGLE_SA_JSON_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# URL del catálogo — el default está en config.py, solo sobreescribir si cambia
# CATALOG_URL=https://lacavalacteos.com/

# Comportamiento del bot
BUFFER_WAIT_SECONDS=5
HISTORY_MAX_ITEMS=28
SESSION_TIMEOUT_MINUTES=60
